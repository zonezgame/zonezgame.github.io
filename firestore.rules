rules_version = '2';
// Luật bảo vệ Firestore cho ZONE Z. Dán toàn bộ file này vào Firestore → Rules → Publish.
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    // Nhân viên và quản lý phải đăng nhập bằng Google (khách dùng nickname nên không giả được).
    function google() {
      return signedIn() && request.auth.token.email != null
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }
    function staffCfg() { return get(/databases/$(db)/documents/config/staff).data; }
    function isAdmin() { return google() && request.auth.token.email.lower() in staffCfg().get('admins', []); }
    function isStaff() { return google() && (request.auth.token.email.lower() in staffCfg().get('emails', []) || isAdmin()); }
    function isMe(uid) { return signedIn() && request.auth.uid == uid; }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }

    // Tài khoản người chơi.
    // Người chơi: đọc và ghi dữ liệu của mình, nhưng không tự sửa các trường do quầy cấp và không ghi khi bị khoá.
    // Nhân viên: xem, nạp flash, giải độc. Quản lý: thêm cộng/trừ TZ, khoá, xoá.
    match /users/{uid} {
      allow read: if isMe(uid) || isStaff();
      allow create: if isMe(uid)
        && !request.resource.data.keys().hasAny(['locked', 'grantRefill', 'grantCure', 'grantTzAt', 'grantTzAmt', 'grantBy']);
      allow update: if isMe(uid) && resource.data.get('locked', false) != true
        && !changed().hasAny(['locked', 'grantRefill', 'grantCure', 'grantTzAt', 'grantTzAmt', 'grantBy']);
      allow update: if isStaff() && changed().hasOnly(['grantRefill', 'grantCure', 'grantBy']);
      allow update: if isAdmin() && changed().hasOnly(['grantRefill', 'grantCure', 'grantTzAt', 'grantTzAmt', 'grantBy', 'locked']);
      allow delete: if isAdmin();
    }

    // Mã đổi quà: người chơi tạo mã của mình; nhân viên đọc và đánh dấu đã dùng một lần.
    match /codes/{code} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && request.resource.data.used == false;
      allow get: if signedIn() && (resource.data.uid == request.auth.uid || isStaff());
      allow list: if isStaff();
      allow update: if isStaff() && resource.data.used == false
        && request.resource.data.used == true
        && changed().hasOnly(['used', 'usedAt', 'usedBy', 'orderK']);
    }

    // Suất chung cả tiệm mỗi ngày: mỗi lần chỉ tăng 1, không vượt trần.
    function okField(f, cap) {
      return !(f in request.resource.data)
        || (request.resource.data[f] is int
            && request.resource.data[f] <= cap
            && request.resource.data[f] <= (resource == null || !(f in resource.data) ? 0 : resource.data[f]) + 1);
    }
    match /quota/{day} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(['k5', 'k6', 'k8', 'k10', 'k15', 'k20'])
        && okField('k5', 7) && okField('k6', 5) && okField('k8', 3)
        && okField('k10', 2) && okField('k15', 1) && okField('k20', 2);
    }

    // Link nhờ bạn chữa: chủ link tạo; người khác bấm chữa một lần.
    match /cures/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && request.resource.data.done == false;
      allow read: if signedIn();
      allow update: if signedIn() && resource.data.done == false
        && request.auth.uid != resource.data.uid
        && request.resource.data.done == true
        && changed().hasOnly(['done', 'by', 'byName', 'doneAt']);
    }

    // config/staff: emails (nhân viên), admins (quản lý). config/game: cài đặt chung của game.
    // Ai cũng đọc được; chỉ quản lý sửa (từ tab Quản lý của trang Quầy).
    match /config/{doc} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
  }
}
